{
    "name": "gitingest",
    "displayName": "Gitingest",
    "description": "Turn any repository into a simple text digest of its codebase.",
    "version": "0.7.1",
    "publisher": "iamshreydxv",
    "engines": {
        "vscode": "^1.63.0"
    },
    "icon": "assets/gitingest-icon.png",
    "categories": [
        "Visualization",
        "Other"
    ],
    "activationEvents": [],
    "main": "./dist/extension.js",
    "contributes": {
        "commands": [
            {
                "command": "vscode-gitingest.analyze",
                "title": "GitIngest: Analyze Current Folder"
            },
            {
                "command": "vscode-gitingest.analyzeFolder",
                "title": "GitIngest: Analyze This Folder"
            },
            {
                "command": "vscode-gitingest.addToIngest",
                "title": "GitIngest: Add to Ingest",
                "category": "GitIngest"
            },
            {
                "command": "vscode-gitingest.reIngest",
                "title": "GitIngest: Re-Ingest Last Folder",
                "category": "GitIngest"
            }
        ],
        "menus": {
            "explorer/context": [
                {
                    "when": "explorerResourceIsFolder",
                    "command": "vscode-gitingest.analyzeFolder",
                    "group": "1_gitingest"
                },
                {
                    "command": "vscode-gitingest.addToIngest",
                    "when": "explorerResourceIsFolder || resourceFilename",
                    "group": "1_gitingest"
                }
            ]
        },
        "configuration": {
            "title": "GitIngest",
            "properties": {
                "gitingest.ingestFolderName": {
                    "type": "string",
                    "default": "gitingest-ingest",
                    "description": "Folder name used to stage files and folders when running GitIngest.",
                    "scope": "resource"
                },
                "gitingest.preserveStructureOnAdd": {
                    "type": "boolean",
                    "default": true,
                    "description": "Preserve the workspace-relative path when adding files or folders to the ingest folder (e.g. src/utils/example.ts is staged as <ingest>/src/utils/example.ts). Disable to stage items flatly by name.",
                    "scope": "resource"
                },
                "gitingest.deleteAfterIngest": {
                    "type": "boolean",
                    "default": false,
                    "description": "Delete the Add to Ingest staging folder after you successfully analyze that staging folder. Analyzing any other folder leaves staging untouched.",
                    "scope": "resource"
                },
                "gitingest.includePatterns": {
                    "type": "array",
                    "items": {
                        "type": "string"
                    },
                    "default": [],
                    "description": "Glob patterns to include in the digest (e.g. src/**, **/*.ts). When empty, every file that is not excluded is included.",
                    "scope": "resource"
                },
                "gitingest.maxFileSize": {
                    "type": "number",
                    "default": 10485760,
                    "minimum": 1024,
                    "maximum": 104857600,
                    "description": "Maximum size, in bytes, of a single file included in the digest. Larger files are skipped.",
                    "scope": "resource"
                },
                "gitingest.fileExclusions": {
                    "type": "array",
                    "items": {
                        "type": "string"
                    },
                    "default": [
                        "**/node_modules",
                        "**/.git"
                    ],
                    "description": "Glob patterns to exclude from ingestion (e.g. **/node_modules, **/*.min.js). Applied in addition to .gitignore and .gitingestignore. Defaults exclude node_modules and .git to avoid errors in deeply nested paths.",
                    "scope": "resource"
                }
            }
        }
    },
    "scripts": {
        "vscode:prepublish": "npm run package",
        "compile": "npm run check-types && npm run lint && node esbuild.js",
        "watch": "npm-run-all -p watch:*",
        "watch:esbuild": "node esbuild.js --watch",
        "watch:tsc": "tsc --noEmit --watch --project tsconfig.json",
        "package": "npm run check-types && npm run lint && node esbuild.js --production",
        "vsix": "npm run package && vsce package --no-dependencies",
        "check-types": "tsc --noEmit",
        "lint": "eslint src",
        "format": "prettier --write .",
        "format:check": "prettier --check .",
        "pretest": "tsc -p tsconfig.test.json",
        "test": "vscode-test",
        "precoverage": "tsc -p tsconfig.test.json",
        "coverage": "vscode-test --coverage && node scripts/report-src-coverage.cjs"
    },
    "devDependencies": {
        "@types/mocha": "^10.0.10",
        "@types/node": "^26.6.0",
        "@types/vscode": "^1.137.0",
        "@typescript-eslint/eslint-plugin": "^8.70.0",
        "@typescript-eslint/parser": "^8.70.0",
        "@vscode/test-cli": "^0.0.15",
        "@vscode/test-electron": "^3.1.0",
        "@vscode/vsce": "^4.0.0",
        "esbuild": "^0.28.2",
        "eslint": "^10.10.0",
        "eslint-config-prettier": "^10.1.8",
        "eslint-plugin-prettier": "^5.5.6",
        "mocha": "^12.0.1",
        "npm-run-all": "^4.1.5",
        "ovsx": "^1.2.0",
        "prettier": "^3.9.6",
        "typescript": "~5.9.3"
    },
    "overrides": {
        "serialize-javascript": ">=7.0.3"
    },
    "keywords": [
        "gitingest",
        "gitingest-analyze",
        "git",
        "ingest",
        "analyze",
        "repository",
        "ai summary"
    ],
    "badges": [
        {
            "url": "https://img.shields.io/badge/license-MIT-blue.png",
            "href": "https://opensource.org/licenses/MIT",
            "description": "MIT License"
        }
    ],
    "licenses": [
        {
            "type": "MIT",
            "url": "https://opensource.org/licenses/MIT"
        }
    ],
    "readme": "README.md",
    "author": {
        "name": "Shrey Purohit",
        "email": "purohitshrey9@gmail.com"
    },
    "galleryBanner": {
        "color": "#fff4da",
        "theme": "light"
    },
    "repository": {
        "type": "git",
        "url": "https://github.com/ShreyPurohit/gitingest-vsextension"
    },
    "qna": "https://marketplace.visualstudio.com/items?itemName=iamshreydxv.gitingest&ssr=false#qna",
    "bugs": {
        "url": "https://github.com/ShreyPurohit/gitingest-vsextension/issues",
        "email": "purohitshrey9@gmail.com"
    },
    "homepage": "https://gitingest.com/",
    "license": "MIT"
}
